# Base URL of the backend API (not a secret; it is compiled into the public bundle).
#
# Local development: the API runs on its own port and allows this app's origin through CORS.
VITE_API_BASE_URL=http://localhost:5241
#
# Same-origin deployment (Docker Compose, or any server that proxies /api to the backend):
# leave it empty so the app calls /api/... on whatever host served it.
# VITE_API_BASE_URL=
